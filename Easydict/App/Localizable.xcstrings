    "hide_menu_bar_icon_msg" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to restore, open the settings page in the query window using the shortcut `Cmd + ,`  then cancel the [Hide Status Bar Icon] option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres restaurar, abre la página de configuración en la ventana de consulta usando el atajo `Cmd + ,` y luego cancela la opción [Ocultar icono de barra de estado]."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻すには、ショートカット `Cmd + ,` でクエリウィンドウの設定ページを開き、[ステータスバーアイコンを非表示] オプションを解除してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre obnovenie otvor stránku s nastaveniami v okne prekladu použitím skratky ⌘ + , a potom zruš možnosť [Skryť ikonu v lište]."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واپس دکھانے کے لیے ترجمے کی ونڈو میں `Cmd + ,` شارٹ کٹ سے ترتیبات کھولیں، پھر [مینو بار کا آئیکن چھپائیں] کا انتخاب ہٹا دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需恢复，请在查词窗口使用快捷键 `Cmd + ,` 打开设置页，然后取消【隐藏菜单栏图标】选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想要還原，請在查詢視窗中使用快速鍵 Cmd + , 開啟設定頁面，然後取消 [隱藏狀態列圖示] 選項。"
          }
        }
      }
    },
