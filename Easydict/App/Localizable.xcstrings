    "setting.advance.ocr_service.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to screenshot translation, clipboard images, and silent screenshot OCR. Codex, OpenAI, and DeepSeek require a vision-capable model. Images are sent to the selected provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la traducción de capturas e imágenes del portapapeles y al OCR silencioso. Codex, OpenAI y DeepSeek requieren un modelo compatible con imágenes. Las imágenes se envían al proveedor seleccionado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショット翻訳、クリップボード画像の翻訳、サイレント OCR に適用されます。Codex、OpenAI、DeepSeek には画像対応モデルが必要です。画像は選択したプロバイダーに送信されます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pre preklad snímok obrazovky a obrázkov zo schránky aj pre tiché OCR snímok. Codex, OpenAI a DeepSeek vyžadujú model s podporou obrázkov. Obrázky sa odošlú vybranému poskytovateľovi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شاٹ کے ترجمے، کلپ بورڈ کی تصاویر اور خاموش اسکرین شاٹ OCR پر لاگو ہوتا ہے۔ Codex، OpenAI اور DeepSeek کے لیے تصاویر قبول کرنے والا ماڈل درکار ہے۔ تصاویر منتخب فراہم کنندہ کو بھیجی جاتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于截图翻译、剪贴板图片和静默截图 OCR。Codex、OpenAI 和 DeepSeek 需要支持图片的模型，图片会发送给所选服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於截圖翻譯、剪貼簿圖片和靜默截圖 OCR。Codex、OpenAI 和 DeepSeek 需要支援圖片的模型，圖片會傳送給所選服務。"
          }
        }
      }
    },
